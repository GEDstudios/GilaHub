{
  "name": "gila-hub",
  "private": true,
  "version": "0.1.0",
  "description": "Gila Hub — where our lines meet. A private, free, cross-platform shared life app for two.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:fast": "vite build",
    "preview": "vite build && wrangler dev --port 8787",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node tests/e2e/run.mjs",
    "icons": "node scripts/render-icons.mjs",
    "glyphs": "node scripts/build-glyphs.mjs",
    "deploy": "vite build && wrangler deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/frank-ruhl-libre": "^5.3.0",
    "@fontsource-variable/heebo": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.2",
    "@phosphor-icons/core": "2.1.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "http_ece": "^1.2.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
