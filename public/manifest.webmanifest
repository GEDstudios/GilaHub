{
  "id": "/",
  "name": "Gila Hub",
  "short_name": "Gila Hub",
  "description": "Life together, sorted. Shared groceries, chores and lists for two — free, private, yours.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#FCF3EF",
  "theme_color": "#FAFAF8",
  "categories": ["productivity", "lifestyle"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Shopping", "short_name": "Shop", "url": "/shop", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Chores", "url": "/chores", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Lists", "url": "/lists", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
